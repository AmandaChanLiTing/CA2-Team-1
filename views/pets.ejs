<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Browse Pets - Rainbow Centre for Pets</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color:#6f42c1;">
        <div class="container">
            <a class="navbar-brand" href="/">🌈 Rainbow Centre for Pets</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link text-white" href="/pets">Browse Pets</a>
                <a class="nav-link text-white" href="/logout">Logout (<%= user.username %>)</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <% if (messages && messages.length > 0) { %>
            <div class="alert alert-success"><%= messages %></div>
        <% } %>
        <% if (errors && errors.length > 0) { %>
            <div class="alert alert-danger"><%= errors %></div>
        <% } %>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Our Pets 🐾</h2>
            <% if (user.role === 'admin') { %>
                <a href="/addPet" class="btn" style="background-color:#6f42c1;color:white;">+ Add New Pet</a>
            <% } %>
        </div>

        <!-- Search / Filter form -->
        <form action="/search" method="GET" class="row g-2 mb-4">
            <div class="col-md-4">
                <input type="text" name="keyword" class="form-control" placeholder="Search name or disability...">
            </div>
            <div class="col-md-3">
                <select name="species" class="form-control">
                    <option value="">All Species</option>
                    <option value="Dog">Dog</option>
                    <option value="Cat">Cat</option>
                    <option value="Bird">Bird</option>
                    <option value="Rabbit">Rabbit</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="adoptionStatus" class="form-control">
                    <option value="">All Status</option>
                    <option value="Available">Available</option>
                    <option value="Pending">Pending</option>
                    <option value="Adopted">Adopted</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100">Search</button>
            </div>
        </form>

        <div class="row">
            <% for (let i = 0; i < pets.length; i++) { %>
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <% if (pets[i].image) { %>
                            <img src="/images/<%= pets[i].image %>" class="card-img-top" alt="<%= pets[i].petName %>" style="height: 200px; object-fit: cover;">
                        <% } %>
                        <div class="card-body">
                            <h5 class="card-title"><%= pets[i].petName %>
                                <span class="badge bg-secondary"><%= pets[i].adoptionStatus %></span>
                            </h5>
                            <p class="card-text">
                                Species: <%= pets[i].species %><br>
                                Breed: <%= pets[i].breed %><br>
                                Age: <%= pets[i].age %> years old
                            </p>
                            <a href="/pets/<%= pets[i].petId %>" class="btn btn-sm" style="background-color:#6f42c1;color:white;">View Profile</a>
                            <% if (user.role === 'admin') { %>
                                <a href="/editPet/<%= pets[i].petId %>" class="btn btn-sm btn-warning">Edit</a>
                                <a href="/deletePet/<%= pets[i].petId %>" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Are you sure you want to delete this pet record?')">Delete</a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
