<!DOCTYPE html>
<html>
<head>
    <title>Admin Portal - Rainbow Centre For Pets</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="row mt-4">

    <div class="col-md-4">
        <div class="card shadow">
            <img src="/images/cats.jpeg"
                 class="card-img-top"
                 alt="Cat">
            <div class="card-body text-center">
                <h5>Manage Users</h5>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow">
            <img src="/images/dogs-on-wheelchair.jpeg"
                 class="card-img-top"
                 alt="Dog">

            <div class="card-body text-center">
                <h5>Manage Pets</h5>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow">
            <img src="/images/rabbits.jpeg"
                 class="card-img-top"
                 alt="Rabbit">

            <div class="card-body text-center">
                <h5>Adoption Records</h5>
            </div>
        </div>
    </div>

</div>
</body>
</html>
