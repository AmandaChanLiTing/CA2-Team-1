<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rainbow Centre for Pets</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color:#6f42c1;">
        <div class="container">
            <a class="navbar-brand" href="/">🌈 Rainbow Centre for Pets</a>
            <div class="navbar-nav ms-auto">
                <% if (user) { %>
                    <a class="nav-link text-white" href="/pets">Browse Pets</a>
                    <a class="nav-link text-white" href="/logout">Logout (<%= user.username %>)</a>
                <% } else { %>
                    <a class="nav-link text-white" href="/login">Login</a>
                    <a class="nav-link text-white" href="/register">Register</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container text-center mt-5">
        <h1>Welcome to Rainbow Centre for Pets 🐾</h1>
        <p class="lead">A web application for managing and showcasing disabled pets available for adoption. Learn about each pet's special care needs and help us find them a loving home.</p>
        <% if (!user) { %>
            <a href="/register" class="btn btn-lg" style="background-color:#6f42c1;color:white;">Get Started</a>
            <a href="/login" class="btn btn-outline-secondary btn-lg">Login</a>
        <% } else { %>
            <a href="/pets" class="btn btn-lg" style="background-color:#6f42c1;color:white;">Browse Pets</a>
        <% } %>
    </div>
</body>
</html>
