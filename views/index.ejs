<!DOCTYPE html>
<html>
<head>
    <title>Rainbow Centre For Pets</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container text-center">

    <h1 class="mt-5">🐾 Welcome to Rainbow Centre For Pets</h1>

    <p class="lead">
        Where every pet is a cherished member of the family.
    </p>

    <img src="/images/Dogs on wheelchair.jpeg"
         alt="Special needs dog"
         class="img-fluid rounded shadow my-4"
         style="max-width: 450px;">
</div>

    <% if (user) { %>

        <p class="mt-3">
            Glad to see you again,
            <strong><%= user.username %></strong>! 🐾
        </p>

        <a href="/dashboard" class="btn btn-primary">
            Dashboard
        </a>

        <a href="/logout" class="btn btn-outline-danger">
            Logout
        </a>

    <% } else { %>

        <a href="/register" class="btn btn-primary">
            Register
        </a>

        <a href="/login" class="btn btn-outline-primary">
            Login
        </a>

    <% } %>

</div>

</body>
</html>