<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= pet.petName %> - Rainbow Centre for Pets</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark" style="background-color:#6f42c1;">
        <div class="container">
            <a class="navbar-brand" href="/">🌈 Rainbow Centre for Pets</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link text-white" href="/pets">Back to Pets</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4" style="max-width: 700px;">
        <div class="card">
            <% if (pet.image) { %>
                <img src="/images/<%= pet.image %>" class="card-img-top" alt="<%= pet.petName %>">
            <% } %>
            <div class="card-body">
                <h2 class="card-title"><%= pet.petName %>
                    <span class="badge bg-secondary"><%= pet.adoptionStatus %></span>
                </h2>
                <p class="card-text">
                    <strong>Species:</strong> <%= pet.species %><br>
                    <strong>Breed:</strong> <%= pet.breed %><br>
                    <strong>Age:</strong> <%= pet.age %> years old<br>
                    <strong>Disability Type:</strong> <%= pet.disabilityType %>
                </p>
                <h5>Special Care Needs</h5>
                <p><%= pet.description %></p>
            </div>
        </div>
    </div>
</body>
</html>
