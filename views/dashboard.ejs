<!DOCTYPE html>
<html>

<head>
    <title>Rainbow Centre For Pets - Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <div class="container">

        <h1 class="mt-5">🐾 Dashboard</h1>

        <div class="card shadow mt-4">
            <div class="card-body">

                <h4>
                    Welcome,
                    <strong>
                        <%= user.username %>
                    </strong>!
                </h4>

                <p class="mb-0">
                    Role:
                    <span class="badge bg-success">
                        <%= user.role %>
                    </span>
                </p>

            </div>
        </div>

        <div class="text-center mt-4">
            <img src="images/cats.jpeg" alt="Pet" class="img-fluid rounded shadow" style="max-width: 250px;">
        </div>

        <div class="mt-4">

            <a href="/pets" class="btn btn-success">
            Browse Pets
            </a>

            <a href="/search" class="btn btn-info">
                Search Pets
            </a>

            <% if (user.role === 'admin') { %>

                <a href="/admin" class="btn btn-primary">
                    Manage Pet Centre
                </a>

                <a href="/addPet" class="btn btn-success">
                    Add Pet
                </a>

            <% } %>

                <a href="/logout" class="btn btn-outline-danger">
                    Logout
                </a>

        </div>
    </div>
    </div>

    </div>

</body>

</html>